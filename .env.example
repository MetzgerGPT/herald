# Herald — environment variables
# Copy to .env, fill in values, never commit .env
# Generate token: python -c "import secrets; print(secrets.token_hex(32))"

# ── Auth ──────────────────────────────────────────────────────────────────────
HERALD_AUTH_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
HERALD_ENV=development
# Comma-separated origins allowed to connect (no trailing slash, no wildcard in prod)
HERALD_CORS_ORIGINS=http://localhost:3000

# ── LLM routing ───────────────────────────────────────────────────────────────
# Hardware profile: i5-1335U, 16GB RAM, Intel Iris Xe (CPU-only, no CUDA)
# qwen2.5:7b (~5GB RAM) — recommended: accurate, safe on 16GB
# phi4         (~8.5GB RAM) — accuracy upgrade: test after qwen2.5:7b works
# llama3.3     (~40GB RAM) — DO NOT USE on this machine, will swap/crash
HERALD_LOCAL_LLM_MODEL=qwen2.5:7b
HERALD_CLOUD_LLM_MODEL=claude-opus-4-7
OLLAMA_BASE_URL=http://localhost:11434

# Cloud LLM keys — only required when cloud fallback is enabled (Phase 3)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── STT ───────────────────────────────────────────────────────────────────────
# faster-whisper model (CPU-only on this machine — no CUDA/GPU acceleration)
# small.en  — recommended: best accuracy/speed balance on i5 CPU
# medium.en — accuracy upgrade, ~2-3x slower (test if latency is acceptable)
# base.en   — too low accuracy, avoid
HERALD_WHISPER_MODEL=small.en
# Cloud STT key — only required when Deepgram fallback is enabled (Phase 3)
# DEEPGRAM_API_KEY=

# ── Context ───────────────────────────────────────────────────────────────────
# Path to TALKY output directory (auto-loads newest .json)
TALKY_OUTPUT_DIR=%USERPROFILE%\talky\output
# Path to Herald schemas directory
HERALD_SCHEMAS_DIR=./context/schemas

# ── TLS (Tailscale / production) ─────────────────────────────────────────────
# Leave empty for local dev — uvicorn runs plain HTTP
# TLS_CERT_PATH=C:\herald\certs\cert.pem
# TLS_KEY_PATH=C:\herald\certs\key.pem
